/// * ezen az oldalon a user egy egy órás kimagasló megjelenítést kap
model RightNowDisplay {
  id        String              @id @default(cuid())
  userId    String
  type      RightNowDisplayType @default(ONE_HOUR)
  startedAt DateTime
  expiresAt DateTime
  createdAt DateTime            @default(now())
  user      Users               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("right_now_displays")
}