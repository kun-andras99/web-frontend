// randi szolgalátatást használó profil
// a username azért kell mert azt csak a regisztrációnál kérjük,
// a nickname lesz az a név amit beállíthat a user magának
// mint negjelenített név, azzal lesz megjelenítve.
model UserData {
  id                     Int                  @id @default(autoincrement())
  userId                 String               @unique
  avatarUrl              String?
  nickname               String?
  description            String?
  bio                    String?
  birth                  DateTime?
  heightCm               Int?
  weightKg               Int?
  shoulderWidth          Int?
  neckCircumference      Int?
  chestCircumference     Int?
  bustCircumference      Int?
  underbustCircumference Int?
  waistCircumference     Int?
  hipCircumference       Int?
  upperArmCircumference  Int?
  forearmCircumference   Int?
  wristCircumference     Int?
  armLength              Int?
  upperArmLength         Int?
  forearmLength          Int?
  thighCircumference     Int?
  kneeCircumference      Int?
  calfCircumference      Int?
  ankleCircumference     Int?
  legLength              Int?
  inseamLength           Int?
  outseamLength          Int?
  handLength             Int?
  handWidth              Int?
  fingerLength           Int?
  braSize                BraSize?
  braSizeSystem          BraSizeSystem?
  cupSize                CupSize?
  breastImplant          BreastImplant?
  breastDevelopment      BreastDevelopment?
  binderSize             BinderSize?
  appCity                AppCity?
  gender                 Gender?
  genderCanSee           GenderCanSee[]
  sexuality              Sexuality?
  sexualityCanSee        SexualityCanSee[]
  transStatus            TransStatus?
  transStatusCanSee      TransStatusCanSee[]
  languages              Languages[]
  hairLength             HairLength?
  hairColor              HairColor?
  eyeColor               EyeColor?
  bodyType               BodyType?
  beard                  Beard?
  bodyHair               BodyHair?
  ethnicity              Ethnicity?
  smoker                 Smoker?
  tattoos                Tattoos?
  piercings              Piercings?
  position               Position?
  dickSize               DickSize?
  dickCircumcision       DickCircumcision?
  fetish                 Fetish?
  sexualOpenness         SexualOpenness?
  fisting                Fisting?
  sadism                 Sadism?
  masochism              Masochism?
  saferSex               SaferSex?
  openTo                 OpenTo?
  goingOutInterests      GoingOutInterest[]
  lifestyleInterests     LifestyleInterest[]
  musicInterests         MusicInterest[]
  movieInterests         MoviesInterest[]
  gamingInterests        GamingInterest[]
  sportsInterests        SportsInterest[]
  booksInterests         BooksInterest[]
  travelInterests        TravelInterest[]
  foodInterests          FoodInterest[]
  artInterests           ArtInterest[]
  technologyInterests    TechnologyInterest[]
  natureInterests        NatureInterest[]
  cultureInterests       CultureInterest[]
  learningInterests      LearningInterest[]
  socialInterests        SocialInterest[]
  automotiveInterests    AutomotiveInterest[]
  outdoorInterests       OutdoorInterest[]
  personalInterests      PersonalInterest[]
  collectingInterests    CollectingInterest[]
  fashionInterests       FashionInterest[]
  eventsInterests        EventsInterest[]
  otherInterests         OtherInterest[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  user                   Users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gender])
  @@index([sexuality])
  @@index([transStatus])
  @@index([appCity])
  @@map("user_datas")
}