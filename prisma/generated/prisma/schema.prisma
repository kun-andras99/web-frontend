generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// * randi szolgalátatást használó profil
///  * a username azért kell mert azt csak a regisztrációnál kérjük,
///  * a nickname lesz az a név amit beállíthat a user magának
///  * mint negjelenített név, azzal lesz megjelenítve.
model Users {
  id                        String                    @id @default(cuid())
  username                  String                    @unique
  email                     String                    @unique
  passwordHash              String
  emailVerified             DateTime?
  role                      UserRole                  @default(USER)
  status                    UserAccountStatus         @default(ACTIVE)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  lat                       Float?
  lng                       Float?
  locationEnabled           Boolean                   @default(false)
  locationUpdatedAt         DateTime?
  lastActiveAt              DateTime?
  relationshipStatus        RelationshipStatus?
  partnerUserId             String?                   @unique
  blogLikes                 BlogLike[]
  blogs                     Blog[]
  conversationParticipants  ConversationParticipant[]
  eyeCandyParticipations    EyeCandyParticipant[]
  eyeCandyVotesReceived     EyeCandyVote[]            @relation("EyeCandyCandidate")
  eyeCandyVotesGiven        EyeCandyVote[]            @relation("EyeCandyVoter")
  receivedFriendRequests    FriendRequest[]           @relation("FriendRequestReceiver")
  sentFriendRequests        FriendRequest[]           @relation("FriendRequestSender")
  friendshipsAsUser1        Friendship[]              @relation("FriendshipUser1")
  friendshipsAsUser2        Friendship[]              @relation("FriendshipUser2")
  galleries                 Gallery[]                 @relation("GalleryOwner")
  gallerySharesGiven        GalleryShare[]            @relation("GalleryShareOwner")
  gallerySharesReceived     GalleryShare[]            @relation("GalleryShareRecipient")
  groupInvitationsReceived  GroupInvitation[]         @relation("GroupInvitationReceiver")
  groupInvitationsSent      GroupInvitation[]         @relation("GroupInvitationSender")
  groupJoinRequestsSent     GroupJoinRequest[]        @relation("GroupJoinRequester")
  groupJoinRequestsReceived GroupJoinRequest[]        @relation("GroupJoinTarget")
  groupMembers              GroupMember[]
  groupVisits               GroupVisit[]              @relation("GroupVisitor")
  groupsCreated             Group[]                   @relation("GroupCreator")
  matchActionsGiven         MatchAction[]             @relation("MatchActionFrom")
  matchActionsReceived      MatchAction[]             @relation("MatchActionTo")
  matchesAsUser1            Match[]                   @relation("MatchUser1")
  matchesAsUser2            Match[]                   @relation("MatchUser2")
  messageReads              MessageRead[]
  messagesSent              Message[]                 @relation("MessageSender")
  moderationActionsGiven    ModerationAction[]        @relation("Moderator")
  notificationsTriggered    Notification[]            @relation("NotificationActor")
  notifications             Notification[]            @relation("NotificationRecipient")
  profileVisitsReceived     ProfileVisit[]            @relation("ProfileVisitedUser")
  profileVisitsMade         ProfileVisit[]            @relation("ProfileVisitor")
  rightNowDisplay           RightNowDisplay[]
  refreshTokens             RefreshToken[]
  reportsCreated            Report[]                  @relation("ReportCreator")
  reportsAgainst            Report[]                  @relation("ReportTargetUser")
  payments                  SubscriptionPayment[]
  blocksReceived            UserBlock[]               @relation("BlockTo")
  blocksGiven               UserBlock[]               @relation("BlockFrom")
  userData                  UserData?
  favoritesGiven            UserFavorite[]            @relation("FavoriteFrom")
  favoritesReceived         UserFavorite[]            @relation("FavoriteTo")
  userFilter                UserFilter?
  userPreference            UserPreference?
  subscriptions             UserSubscription[]
  partnerUser               Users?                    @relation("UserPartner", fields: [partnerUserId], references: [id])
  partnerOf                 Users?                    @relation("UserPartner")
  verificationTokens        VerificationToken[]

  @@index([lat, lng])
  @@index([locationEnabled])
  @@index([status])
  @@index([createdAt])
  @@index([lastActiveAt])
  @@index([partnerUserId])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  user       Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(cuid())
  tokenHash String                @unique
  userId    String
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())
  user      Users                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

