/// * profil megtekintéseket mentük amikor egy user
///  * megtekinti egy másik user profilját.
model ProfileVisit {
  id            String   @id @default(cuid())
  visitorId     String
  visitedUserId String
  visitedAt     DateTime @default(now())
  visitedUser   Users    @relation("ProfileVisitedUser", fields: [visitedUserId], references: [id], onDelete: Cascade)
  visitor       Users    @relation("ProfileVisitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, visitedUserId])
  @@index([visitedUserId, visitedAt])
  @@index([visitedUserId, visitorId])
  @@index([visitorId, visitedAt])
  @@map("profile_visits")
}

/// * ez arra szolgál amikor egy user megtekint csoportot,
///  * azt ide mentjük, mert megjelenítjük.
model GroupVisit {
  id        String   @id @default(cuid())
  groupId   String
  visitorId String
  visitedAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  visitor   Users    @relation("GroupVisitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([groupId, visitedAt])
  @@index([visitorId, visitedAt])
  @@map("group_visits")
}

/// * egy user tud létrehozni galériákat. kiválaszthatja
///  * hogy a galéria publikus vagy privát legyen.
///  * ha usernek van egy privát albumja, akkor azt megtudja
///  * osztani más userrel. alapból egy órára, de választható:
///  ** három óra
///  ** egy nap
///  ** egy hét
///  * alapból van neki egy Profilképek galériája, ami
///  * nem tartalmaz képeket.
model Gallery {
  id         String            @id @default(cuid())
  ownerId    String
  name       String
  type       GalleryType       @default(USER)
  visibility GalleryVisibility @default(PRIVATE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  owner      Users             @relation("GalleryOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  images     GalleryImage[]
  shares     GalleryShare[]    @relation("GalleryShared")

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([visibility])
  @@map("galleries")
}

/// * galéria képek
model GalleryImage {
  id         String   @id @default(cuid())
  galleryId  String
  url        String
  storageKey String?
  mimeType   String?
  fileSize   Int?
  width      Int?
  height     Int?
  isAvatar   Boolean  @default(false)
  sortOrder  Int      @default(0)
  uploadedAt DateTime @default(now())
  gallery    Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, sortOrder])
  @@index([galleryId, uploadedAt])
  @@index([galleryId, isAvatar])
  @@map("gallery_images")
}

/// * privát album megosztására,
model GalleryShare {
  id          String    @id @default(cuid())
  galleryId   String
  ownerId     String
  recipientId String
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  purgeAfter  DateTime
  gallery     Gallery   @relation("GalleryShared", fields: [galleryId], references: [id], onDelete: Cascade)
  owner       Users     @relation("GalleryShareOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient   Users     @relation("GalleryShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([galleryId, recipientId])
  @@index([recipientId, expiresAt])
  @@index([expiresAt])
  @@index([purgeAfter])
  @@map("gallery_shares")
}

/// * egy user tud létrehozni csoportot. itt mint creator
///  * kapcsolódik a userhez. be tudja állítani a láthatóságát,
///  * members - csoport tagok tároslása
///  * joinRequests - ha pricát a user, ide mentjük a csatlakozási
///  * kérelmeket.
///  * invitations - amennyiben a csoport adminja küld meghívót
///  * egy usernek aki nem tagja a csoportnak.
model Group {
  id           String             @id @default(cuid())
  name         String
  description  String?
  creatorId    String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  visibility   GroupVisibility    @default(PUBLIC)
  invitations  GroupInvitation[]
  joinRequests GroupJoinRequest[]
  members      GroupMember[]
  visits       GroupVisit[]
  creator      Users              @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([visibility])
  @@index([createdAt])
  @@map("groups")
}

/// * csoport tag - egy csoport és user közötti kapcsolathoz.
model GroupMember {
  id       String          @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     Users           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// * csatlakozás egy csoporthoz kérés amennyiben privát
///  * egy csoport, tud a user kérni csatlakozási kérelmet.
model GroupJoinRequest {
  id            String                 @id @default(cuid())
  groupId       String
  requesterId   String
  status        GroupJoinRequestStatus @default(PENDING)
  createdAt     DateTime               @default(now())
  respondedAt   DateTime?
  respondedById String?
  group         Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requester     Users                  @relation("GroupJoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  respondedBy   Users?                 @relation("GroupJoinTarget", fields: [respondedById], references: [id])

  @@unique([groupId, requesterId])
  @@index([groupId, status])
  @@index([requesterId, status])
  @@map("group_join_requests")
}

/// * most van egy user akinek van egy csoportja ami privát.
///  * ugye oda egy másik user csak úgy tud csatlakozni ha
///  * jelentkezik ebbe a csoportba, vagy a csoport adminja küld
///  * neki egy meghívót. ezt a meghívót akár elfogadhatja,
///  * akár elutasíthatja.
model GroupInvitation {
  id          String                @id @default(cuid())
  groupId     String
  senderId    String
  receiverId  String
  status      GroupInvitationStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  respondedAt DateTime?
  group       Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  receiver    Users                 @relation("GroupInvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      Users                 @relation("GroupInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, receiverId])
  @@index([receiverId, status])
  @@map("group_invitations")
}

/// * egy user tud létrehozni blogot.
///  * be tudja állítani hogy publikus vagy privát legyen.
///  * ha privát, akkor más userek nem látják, ellenben ő látja
///  * a saját profilján, ahol aktiválhatja újra publikussá.
///  * kellenek a blognak a tagjei ha meg szeretném őket jeleteni.
///  * likeok az összes like kiírása végett.
model Blog {
  id         String         @id @default(cuid())
  authorId   String
  title      String
  content    String
  visibility BlogVisibility @default(PUBLIC)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  likes      BlogLike[]
  tags       BlogTag[]
  author     Users          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId, createdAt])
  @@index([visibility, createdAt])
  @@map("blogs")
}

/// * ha lehet legyen egy külön model ahol előre megadott blog
///  * tag-ek vannak, legalább 40 tag-et írj bele angolul, mert
///  * ezeket a user külön kiválaszthatja a blogjához
///
///  * egy blognak vannak tagjei, ez alapján akár szűrhetünk is.
model BlogTag {
  id        String   @id @default(cuid())
  name      String
  blogId    String
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, name])
  @@index([name])
  @@map("blog_tags")
}

/// *
///  * egy user tudja like-olni egy másik user blogját. ha a sajátja akkor ne tudja. egy user csak egyszer likeolhat egy blogot, és unlikeolhat.
model BlogLike {
  id        String   @id @default(cuid())
  blogId    String
  userId    String
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([blogId, userId])
  @@index([userId])
  @@map("blog_likes")
}

/// *
///  * egy usernek több user is lehet favoritja, rájuk egy gombnyomással szűrhet, külön megjelenítés adatlapon...
model UserFavorite {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())
  fromUser   Users    @relation("FavoriteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     Users    @relation("FavoriteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@map("user_favorites")
}

/// *
///  * egy user blockolhat egy felhasználót, ilyenkor annak a usernek az adatlapját nem éri el. amelyik blokkolt, ha szeretné vissza is tudja oldani a tiltást.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   Users    @relation("BlockTo", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   Users    @relation("BlockFrom", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

/// *
///  * egy user tud küldeni a jelenleg bejelentkezett usernek egy barátkérést, ilyenkor azt megjelenítjük neki notificationban
model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  receiver    Users               @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      Users               @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("friend_requests")
}

/// *
///  * a már aktív, mind a két usertől elfogadott barátság.
model Friendship {
  id        String           @id @default(cuid())
  user1Id   String
  user2Id   String
  status    FriendshipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  endedAt   DateTime?
  pairKey   String           @unique
  user1     Users            @relation("FriendshipUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     Users            @relation("FriendshipUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@index([user1Id])
  @@index([user2Id])
  @@index([status])
  @@map("friendships")
}

/// *
///  * jelenlegi user tud likeolni/match szivezni egy másik usert aki beállította hogy megjelenhet a matchek-ben
model MatchAction {
  id         String          @id @default(cuid())
  fromUserId String
  toUserId   String
  type       MatchActionType
  createdAt  DateTime        @default(now())
  fromUser   Users           @relation("MatchActionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     Users           @relation("MatchActionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@map("match_actions")
}

/// * ha a jelenlegi user likeolt valakit, és az nem likeolta, akkor:
///  ** megy tovább a matchekben, másokait likeolhat
///  * különben ha likeolta
///  ** matcheltek, így közös matchük van.
///  * erről értesítést küldünk mind a 2 usernek.
model Match {
  id          String      @id @default(cuid())
  user1Id     String
  user2Id     String
  status      MatchStatus @default(ACTIVE)
  matchedAt   DateTime    @default(now())
  unmatchedAt DateTime?
  pairKey     String      @unique
  user1       Users       @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2       Users       @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user2Id])
  @@index([status])
  @@map("matches")
}

/// * az admin létre tud hozni egy amolyan eye candy contestet, amit minden user lát
///  * és külön lehet rá jelentkezni a megadott jelentkezési időtől.
///  * példa:
///  * jelentkezés kezdete
///  * kezdődik  = Monday 00:00
///  * végződik    = Sunday 23:59
///  * miután vége, töröljük az adatokat.
model EyeCandyContest {
  id           String                @id @default(cuid())
  name         String?
  startAt      DateTime
  endAt        DateTime
  createdAt    DateTime              @default(now())
  participants EyeCandyParticipant[]
  votes        EyeCandyVote[]

  @@index([startAt, endAt])
  @@map("eye_candy_contests")
}

/// * ezen a "versenyen" résztvevő userek, itt mentjük azt
///  * hogy countyCode, region alapján az első 20 leg értékeltebb usert,
///  * amit a user profil adataiba is mentünk hogy később ki tudjuk írni
///  * hogy pl 3x ért el helyezést, 1: 14., 2: 10., 3: 16
model EyeCandyParticipant {
  id             String          @id @default(cuid())
  contestId      String
  userId         String
  countryCode    String?
  region         String?
  city           String?
  totalScore     Int             @default(0)
  voteCount      Int             @default(0)
  globalRank     Int?
  regionalRank   Int?
  participatedAt DateTime        @default(now())
  images         EyeCandyImage[]
  contest        EyeCandyContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user           Users           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId, totalScore])
  @@index([contestId, region, totalScore])
  @@map("eye_candy_participants")
}

/// * egy ilyen versenyre 3 képet lehet feltölteni amik alapján
///  * más user értékelheti a verseny résztvevőjét.
model EyeCandyImage {
  id            String              @id @default(cuid())
  participantId String
  url           String
  storageKey    String?
  sortOrder     Int                 @default(0)
  uploadedAt    DateTime            @default(now())
  participant   EyeCandyParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, sortOrder])
  @@map("eye_candy_images")
}

/// * jelenlegi user szavaz egy eye candyban résztvevő userre
///  * ha skippeljük akkor nulla
///  * egy user csak egyszer szavazhat egy contesten résztvevő userre
model EyeCandyVote {
  id                   String          @id @default(cuid())
  contestId            String
  voterId              String
  candidateId          String
  action               EyeCandyAction
  rating               Int?
  candidateCountryCode String?
  candidateRegion      String?
  createdAt            DateTime        @default(now())
  candidate            Users           @relation("EyeCandyCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  contest              EyeCandyContest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  voter                Users           @relation("EyeCandyVoter", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([contestId, voterId, candidateId])
  @@index([contestId, candidateId])
  @@index([contestId, voterId])
  @@index([createdAt])
  @@map("eye_candy_votes")
}

/// * ezen az oldalon a user egy egy órás kimagasló megjelenítést kap
model RightNowDisplay {
  id        String              @id @default(cuid())
  userId    String
  type      RightNowDisplayType @default(ONE_HOUR)
  startedAt DateTime
  expiresAt DateTime
  createdAt DateTime            @default(now())
  user      Users               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("quick_displays")
}

/// * két (vagy több) user közötti beszélgetés konténere.
///  * a résztvevőket a ConversationParticipant köti hozzá, hogy
///  * a jövőben csoportos chat is elférjen ugyanezen a modellen.
model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
  @@map("conversations")
}

/// * egy user és egy beszélgetés közötti kapcsolat: mikor
///  * csatlakozott, törölte-e (csak) magának a beszélgetést,
///  * és meddig olvasta el az üzeneteket (lastReadAt) — ez adja
///  * az "olvasatlan üzenetek száma" számítás alapját.
model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  deletedAt      DateTime?
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           Users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, deletedAt])
  @@map("conversation_participants")
}

/// * két user közötti beszélgetés üzenete. az olvasottságot
///  * a MessageRead táblában mentjük soronként (ki, mikor olvasta),
///  * ebből számolható ki az olvasatlan üzenetek száma is.
model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType         @default(TEXT)
  content        String?
  sentAt         DateTime            @default(now())
  revokedAt      DateTime?
  attachments    MessageAttachment[]
  reads          MessageRead[]
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Users               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([senderId, sentAt])
  @@map("messages")
}

/// * egy user egy üzenetet csak egyszer tud "láttamozni"
model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("message_reads")
}

/// * üzenetben lehetőség van kép küldésére is, nem
///  * csak szöveges üzenet küldésére.
model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  url        String
  storageKey String?
  mimeType   String?
  fileSize   Int?
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// * értesítés | értesített<>értesítő | értesítés típusa
///  * pl. ha user likeolt egy usert, akkor az a user értesítést
///  * kap hogy a likeoló user likeolta őt.
///  * entityId/entityType: generikus hivatkozás arra az entitásra,
///  * ami az értesítést kiváltotta (pl. type=MATCH -> entityType="Match",
///  * entityId=<matchId>); az alkalmazás értelmezi type szerint.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String?
  message     String?
  entityId    String?
  entityType  String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  actor       Users?           @relation("NotificationActor", fields: [actorId], references: [id])
  recipient   Users            @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([actorId, createdAt])
  @@map("notifications")
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetId     String?
  targetUserId String?
  type         ReportType
  reason       String
  description  String?
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  reporter     Users        @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   Users?       @relation("ReportTargetUser", fields: [targetUserId], references: [id])

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([targetUserId])
  @@map("reports")
}

model ModerationAction {
  id           String               @id @default(cuid())
  moderatorId  String
  targetUserId String?
  action       ModerationActionType
  reason       String?
  metadata     Json?
  createdAt    DateTime             @default(now())
  moderator    Users                @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([moderatorId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("moderation_actions")
}

/// *
///  * egy vip lehetőség van, egy ár. egy hónapra.
///  * alap user:
///  * - alapból 60 usert lát a nearby users oldalon
///  * - heti 2 alaklommal tud a RightNow-ban megjelenni
///  * - az utolsó 15 látogatóját látja,
///  * VIP felhasználó:
///  * mindenre korlátlan felhasználási engedélyt kap.
///  * ! és akkor itt jön a csavar...
///  * nem egy user nem ér el minden funkciót teljesen..
///  * a users nearby oldalon 120 usert tud megjeleníteni,
///  * többihez VIP tagság kell.
///  * vip tagság esetén 1-3 órás megjelenítés között tud
///  * indítani ahol több user éri el. egy héten egy sima
///  * user kettő alkalommal tudjon indítani ilyen
///  * megjelenítést csak egy órában. VIP user egy nap háromszor is tud.
///  * sima user csak egy privát galériát hozhat létre 5 fotóval.
///  * vip user korlátlan mennyiségű mappát. itt figyelni kell hogy a
///  * mappa vip tagság idején lett-e létrehozva, mert ha lejár akkor
///  * lezárjuk azokat a mappákat.
///  *
///  * ! MEGJEGYZÉS: a business-fiókos VIP terv (BusinessSubscription /
///  * ! BusinessPayment) egyelőre nincs a sémában — ha a business-oldal
///  * ! elkészül, ugyanezzel a mintával (külön subscription+payment pár,
///  * ! saját VipPlan reláció) érdemes hozzáadni.
model VipPlan {
  id            String                @id @default(cuid())
  tier          VipTier               @unique
  name          String
  price         Decimal               @db.Decimal(10, 2)
  durationDays  Int
  active        Boolean               @default(true)
  features      Json
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  payments      SubscriptionPayment[]
  subscriptions UserSubscription[]

  @@map("vip_plans")
}

model UserSubscription {
  id          String                @id @default(cuid())
  userId      String
  planId      String
  status      SubscriptionStatus    @default(PENDING)
  startedAt   DateTime
  expiresAt   DateTime
  cancelledAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  payments    SubscriptionPayment[]
  plan        VipPlan               @relation(fields: [planId], references: [id])
  user        Users                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_subscriptions")
}

model SubscriptionPayment {
  id                String            @id @default(cuid())
  userId            String
  planId            String
  subscriptionId    String?
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("HUF")
  status            PaymentStatus     @default(PENDING)
  provider          String?
  providerPaymentId String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?
  plan              VipPlan           @relation(fields: [planId], references: [id])
  subscription      UserSubscription? @relation(fields: [subscriptionId], references: [id])
  user              Users             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([providerPaymentId])
  @@map("subscription_payments")
}

