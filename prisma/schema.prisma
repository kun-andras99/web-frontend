generator client {
  provider = "prisma-client-js"
//   output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * USER AND REGISTRATION - LOGIN
 */
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/**
 * USER PROFILE DATA AFTER REGISTRATION
 */
enum Gender {
  MAN
  WOMAN
  TRANS_MAN
  TRANS_WOMAN
}

enum GenderInterest {
  MAN
  WOMAN
  TRANS_MAN
  TRANS_WOMAN
}

enum Sexuality {
  STRAIGHT
  BISEXUAL
  GAY
  LESBIAN
  PANSEXUAL
  ASEXUAL
  OTHER
}

enum SexualityInterest {
  STRAIGHT
  BISEXUAL
  GAY
  LESBIAN
  PANSEXUAL
  ASEXUAL
  OTHER
}

enum LookingFor {
  CHAT
  FRIENDSHIP
  CASUAL_DATING
  SERIOUS_RELATIONSHIP
  HOOKUP
  NETWORKING
  NOTHING_SPECIFIC
}

enum RelationshipStatus {
  SINGLE
  IN_RELATION
  ENGAGED
  MARRIED
  SEPARATED
  DIVORCED
  WIDOWED
  COMPLICATED
  OPEN
}

enum TransStatus {
  CIS
  TRANS
}

enum City {
  CENTRUM
  STRAIGHT
  BISEXUAL
  GAY
  LESBIAN
  TRANS
}

model User {
  id String @id @default(cuid())

  username      String    @unique
  email         String    @unique
  password      String
  passwordHash  String
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lat               Float?
  lng               Float?
  locationEnabled   Boolean   @default(false)
  locationUpdatedAt DateTime?

  role UserRole @default(USER)

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  relationshipStatus RelationshipStatus?
  lookingFor         UserLookingFor[]
  genderInterest     UserGenderInterest[]
  sexualityInteres   UserSexualityInterest[]
  userData           UserData?

  //   folders     GalleryFolder[]
  //   images      GalleryImage[]
  //   likes       ImageLike[]
  //   permissions FolderPermission[]

  //   ownedGroups    Group[]         @relation("OwnedGroups")
  //   groups         Group[]
  //   groupMembers   GroupMember[]   @relation("GroupMembers")
  userPreference UserPreference?

  @@index([lat, lng])
  @@index([locationEnabled])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(cuid())
  tokenHash String                @unique
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model UserData {
  id     Int    @id @default(autoincrement())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  avatar      String?
  avatarUrl   String?
  nickname    String?
  description String?
  bio         String?

  birth DateTime

  heightCm Int?
  weightKg Int?

  gender    Gender?
  sexuality Sexuality?
  pronouns  String?

  city    City?

  transStatus TransStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gender])
  @@index([sexuality])
  @@index([city])
  @@map("user_data")
}

model UserPreference {
  id     Int    @id @default(autoincrement())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  minAge Int?
  maxAge Int?

  minHeightCm Int?
  maxHeightCm Int?

  maxDistanceKm Int?

  verifiedOnly     Boolean @default(false)
  locationRequired Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model UserLookingFor {
  id Int @id @default(autoincrement())

  userId String
  value  LookingFor

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
  @@index([userId])
  @@index([value])
  @@map("user_looking_for")
}

model UserGenderInterest {
  id Int @id @default(autoincrement())

  userId String
  value  GenderInterest

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
  @@index([userId])
  @@index([value])
  @@map("user_gender_interest")
}

model UserSexualityInterest {
  id Int @id @default(autoincrement())

  userId String
  value  SexualityInterest

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
  @@index([userId])
  @@index([value])
  @@map("user_sexuality_interest")
}

